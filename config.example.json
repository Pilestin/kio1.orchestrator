{
    "provider": "ollama",
    "allowed_providers": [
        "ollama",
        "openai",
        "anthropic",
        "openrouter"
    ],
    "model": "ministral-3:3b",
    "prompt_path": "prompts/kio1_system_prompt_ver2.txt",
    "chat_directory": "chats",
    "temperature": 0.2,
    "request_timeout": 300.0,
    "keep_alive": -1,
    "max_output_tokens": 4096,
    "telemetry": {
        "enabled": false,
        "service_name": "kio1-orchestrator",
        "otlp_http_endpoint": "http://YOUR_HOST:4318",
        "otlp_bearer_token": "local-dev-otlp-token",
        "metric_export_interval_ms": 5000,
        "trace_sample_ratio": 1.0,
        "kio_id": "kio1",
        "deployment_environment": "local"
    },
    "dispatch": {
        "enabled": true,
        "request_timeout": 60,
        "max_parallel_steps": 4,
        "workspace": {
            "path": "",
            "entry_point": ""
        },
        "health": {
            "enabled": true,
            "interval": 30,
            "timeout": 3,
            "failures_before_unreachable": 2,
            "path": "/health"
        },
        "failover": {
            "enabled": true,
            "max_attempts": 2
        },
        "selection": {
            "enabled": true,
            "window": 20,
            "explore_every": 10
        },
        "policy": {
            "gates": [
                {
                    "before": [
                        "deployment",
                        "packaging"
                    ],
                    "requires": [
                        "test_automation",
                        "cybersecurity_validation"
                    ],
                    "verdict": [
                        "clean"
                    ]
                }
            ],
            "block_on_review_required": false
        },
        "agents": {
            "KIO2": {
                "endpoint": "http://127.0.0.1:8102",
                "path": "/execute",
                "description": "Bug localization, diagnosis, dynamic slicing, execution replay, and trace comparison. Does NOT generate fixes.",
                "capabilities": [
                    "bug_localization",
                    "diagnosis",
                    "replay",
                    "trace_alignment"
                ]
            },
            "KIO3": {
                "endpoint": "http://127.0.0.1:8103",
                "path": "/execute",
                "description": "Natural-language requirements engineering, user stories, and acceptance criteria.",
                "capabilities": [
                    "requirements_engineering",
                    "user_stories",
                    "acceptance_criteria"
                ]
            },
            "KIO4": {
                "endpoint": "http://127.0.0.1:8104",
                "path": "/execute",
                "description": "Software architecture planning and component design.",
                "capabilities": [
                    "architecture_design",
                    "component_design"
                ]
            },
            "KIO5": {
                "endpoint": "http://127.0.0.1:8105",
                "path": "/execute",
                "description": "Synthetic data generation.",
                "capabilities": [
                    "synthetic_data_generation"
                ]
            },
            "KIO6": {
                "endpoint": "http://127.0.0.1:8106",
                "path": "/execute",
                "description": "Data validation and quality analysis: checks that code is aligned with its requirements (where each one is implemented, whether it is tested, whether its acceptance criteria hold) and validates datasets.",
                "capabilities": [
                    "data_validation",
                    "quality_analysis"
                ]
            },
            "KIO7": {
                "endpoint": "http://127.0.0.1:8107",
                "path": "/execute",
                "description": "Code generation and code understanding.",
                "capabilities": [
                    "code_generation",
                    "code_understanding"
                ]
            },
            "KIO8": {
                "endpoint": "http://127.0.0.1:8108",
                "path": "/execute",
                "description": "Build, deployment, DevOps, and packaging.",
                "capabilities": [
                    "build",
                    "deployment",
                    "devops",
                    "packaging"
                ]
            },
            "KIO9": {
                "endpoint": "http://127.0.0.1:8109",
                "path": "/execute",
                "description": "Responsible AI and regulatory compliance review.",
                "capabilities": [
                    "responsible_ai",
                    "compliance_review"
                ]
            },
            "KIO10": {
                "endpoint": "http://127.0.0.1:8110",
                "path": "/execute",
                "description": "TinyML and energy-efficiency analysis.",
                "capabilities": [
                    "tinyml",
                    "energy_efficiency"
                ]
            },
            "KIO11": {
                "endpoint": "http://127.0.0.1:8111",
                "path": "/execute",
                "description": "Test automation and validation.",
                "capabilities": [
                    "test_automation",
                    "validation"
                ]
            },
            "KIO12": {
                "endpoint": "http://127.0.0.1:8112",
                "path": "/execute",
                "description": "Cybersecurity validation.",
                "capabilities": [
                    "cybersecurity_validation"
                ]
            },
            "KIO13": {
                "endpoint": "http://127.0.0.1:8113",
                "path": "/execute",
                "description": "Developer training and onboarding material.",
                "capabilities": [
                    "developer_training",
                    "onboarding"
                ]
            },
            "Pytest": {
                "type": "cli",
                "description": "Runs part of this repository's test suite and reports the result. One module rather than all of them: a full run takes longer than dispatch.request_timeout allows a step.",
                "command": [
                    "python",
                    "-m",
                    "pytest",
                    "-q",
                    "tests/test_policy_gates.py"
                ],
                "capabilities": [
                    "test_execution"
                ]
            },
            "GitHistory": {
                "type": "cli",
                "description": "Reads the recent commit history of this repository.",
                "command": [
                    "git",
                    "log",
                    "--oneline",
                    "-20"
                ],
                "capabilities": [
                    "repository_history"
                ]
            },
            "WeatherForecast": {
                "type": "http",
                "description": "Current temperature and weather at a latitude and longitude, from the free Open-Meteo API.",
                "url": "https://api.open-meteo.com/v1/forecast?latitude={arguments.latitude}&longitude={arguments.longitude}&current_weather=true",
                "method": "GET",
                "arguments": {
                    "latitude": {
                        "type": "number",
                        "required": true,
                        "description": "Latitude in decimal degrees"
                    },
                    "longitude": {
                        "type": "number",
                        "required": true,
                        "description": "Longitude in decimal degrees"
                    }
                },
                "result_path": [
                    "current_weather"
                ],
                "health_url": "https://api.open-meteo.com/v1/forecast?latitude=0&longitude=0&current_weather=true",
                "capabilities": [
                    "weather_check"
                ]
            }
        }
    },
    "provider_options": {
        "endpoint": "http://127.0.0.1:11434",
        "context_window_size": 16384,
        "think": false
    },
    "orchestration": {
        "review": true,
        "max_rounds": 2,
        "review_prompt_path": "prompts/kio1_review_prompt.txt"
    }
}
