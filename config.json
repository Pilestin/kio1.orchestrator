{
    "provider": "ollama",
    "allowed_providers": ["ollama", "openai", "anthropic"],
    "model": "ministral-3:3b",
    "prompt_path": "prompts/kio1_system_prompt_ver1.txt",
    "chat_directory": "chats",
    "temperature": 0.2,
    "request_timeout": 120,
    "keep_alive": -1,
    "max_output_tokens": 4096,
    "telemetry": {
        "enabled": true,
        "service_name": "kio1-orchestrator",
        "otlp_http_endpoint": "http://YOUR_HOST:4318",
        "otlp_bearer_token": "local-dev-otlp-token",
        "metric_export_interval_ms": 5000,
        "trace_sample_ratio": 1.0,
        "kio_id": "kio1",
        "deployment_environment": "local"
    },
    "dispatch": {
        "enabled": true,
        "request_timeout": 60,
        "max_parallel_steps": 4,
        "agents": {
            "KIO2": {
                "endpoint": "http://localhost:8102",
                "path": "/execute",
                "capabilities": ["bug_localization", "diagnosis", "fix_recommendation"]
            },
            "KIO10": {
                "endpoint": "http://localhost:8110",
                "path": "/execute",
                "capabilities": ["tinyml", "energy_efficiency"]
            }
        }
    },
    "provider_options": {
        "endpoint": "http://localhost:11434",
        "context_window_size": 16384
    }
}
