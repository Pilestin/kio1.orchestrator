# Copy this file to .env and fill in what you use. .env is not tracked by git.
# Values already set in the environment take precedence over this file.

# Model providers: only the one you select in the console is needed.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# The console's administration token. start.py generates one in
# data/registry-token when this is not set.
# KIO1_REGISTRY_TOKEN=choose-a-long-random-value

# Consortium KIOs. A target's headers read these as ${NAME}; a step addressed
# to one whose variable is unset fails, naming it, before anything is sent.
# KIO12 (ERARGE security review): the token ERARGE issued for its model gateway.
# KIO12_LLM_TOKEN=
# KIO9 (ERGTECH compliance review) needs no token today. If one is introduced,
# add "headers": {"Authorization": "Bearer ${KIO9_TOKEN}"} to its target.
# KIO9_TOKEN=

# On a server (docs/deploy.md): run_with_tailscale.py fills these in itself.
# The model machine's Ollama, over Tailscale:
# KIO1_PROVIDER_ENDPOINT="http://100.71.36.18:11434"
# Where the console listens, and the name it is reached by:
# KIO1_HOST="100.x.y.z"
# KIO1_CONSOLE_NAME="opeva-cloud-server"
# The public https://…ts.net link it is published at (Tailscale Funnel):
# KIO1_PUBLIC_URL=""
# The console password's hash; set it with: python3 start.py --set-password
# KIO1_CONSOLE_PASSWORD_HASH=